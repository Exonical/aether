# First build the workspace artifact, then build this image with runtime/ as the context.
FROM node:24-bookworm-slim AS binary
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libatomic1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 aether \
    && useradd --uid 10001 --gid aether --no-create-home aether \
    && mkdir -p /var/lib/aether/do /var/lib/aether/kv /var/lib/aether/r2 \
    && chown -R aether:aether /var/lib/aether
COPY --from=binary /build/node_modules/workerd/bin/workerd /usr/local/bin/workerd
COPY dist/workspace/ /opt/aether/
ENV AETHER_EXECUTION_ENABLED=false AETHER_DEPARTMENTS=false AETHER_PUBLIC_URL=http://localhost:8080
USER 10001:10001
WORKDIR /opt/aether
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/workerd"]
CMD ["serve", "/opt/aether/workspace.capnp.bin", "--binary", "--experimental", "--socket-addr=http=0.0.0.0:8080", "--directory-path=aether:assets-disk=/opt/aether/assets", "--directory-path=aether:do-storage=/var/lib/aether/do", "--directory-path=kv:storage=/var/lib/aether/kv", "--directory-path=r2:storage=/var/lib/aether/r2"]
