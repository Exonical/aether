ARG RHEL_BASE=registry.access.redhat.com/ubi10/nodejs-24:10.2
FROM ${RHEL_BASE}
USER 0
RUN dnf install -y git-core python3 sudo shadow-utils ca-certificates && dnf clean all
RUN if getent passwd default > /dev/null; then userdel default; fi
WORKDIR /opt/aether
COPY runner.mjs bootstrap.mjs ./
ENTRYPOINT []
EXPOSE 9006
CMD ["node", "bootstrap.mjs"]
