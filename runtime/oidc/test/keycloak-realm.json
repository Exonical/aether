{
  "realm": "aether",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "aether",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "fixture-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8080/gatekeeper/oidc/oauth"
      ],
      "webOrigins": [
        "http://127.0.0.1:8080"
      ],
      "defaultClientScopes": [
        "profile",
        "email"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "id.token.signed.response.alg": "RS256",
        "backchannel.logout.url": "http://host.docker.internal:8080/gatekeeper/oidc/backchannel-logout",
        "backchannel.logout.session.required": "true"
      },
      "protocolMappers": [
        {
          "name": "uidNumber",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "uidNumber",
            "claim.name": "uidNumber",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "gidNumber",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "gidNumber",
            "claim.name": "gidNumber",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@example.com",
      "firstName": "admin",
      "lastName": "Fixture",
      "credentials": [
        {
          "type": "password",
          "value": "aether-test-secret",
          "temporary": false
        }
      ],
      "attributes": {
        "uidNumber": [
          "12345"
        ],
        "gidNumber": [
          "23456"
        ]
      }
    },
    {
      "username": "other",
      "enabled": true,
      "emailVerified": true,
      "email": "other@example.com",
      "firstName": "other",
      "lastName": "Fixture",
      "credentials": [
        {
          "type": "password",
          "value": "aether-test-secret",
          "temporary": false
        }
      ],
      "attributes": {
        "uidNumber": [
          "12346"
        ],
        "gidNumber": [
          "23456"
        ]
      }
    },
    {
      "username": "new",
      "enabled": true,
      "emailVerified": true,
      "email": "new@example.com",
      "firstName": "new",
      "lastName": "Fixture",
      "credentials": [
        {
          "type": "password",
          "value": "aether-test-secret",
          "temporary": false
        }
      ],
      "attributes": {
        "uidNumber": [
          "12347"
        ],
        "gidNumber": [
          "23456"
        ]
      }
    }
  ]
}
